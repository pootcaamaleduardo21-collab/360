# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Service-role key — NEVER expose this to the browser (no NEXT_PUBLIC_ prefix).
# Used ONLY in server-side API routes (e.g. /api/admin/stats).
# Get it from: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Super Admin ────────────────────────────────────────────────────────────────
# The email that always receives super_admin role regardless of DB metadata.
# Set this to YOUR email address.
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=tu@email.com

# Optional comma-separated list for local role-testing access.
# NEXT_PUBLIC_ROLE_TESTER_EMAILS=qa1@email.com,qa2@email.com

# ── Optional: Cloudinary (alternative CDN) ────────────────────────────────────
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ── Optional: Google Maps Embed API (POI route maps) ─────────────────────────
# Enables inline route maps in the POI panel — FREE with Maps Embed API.
# Get your key at: https://console.cloud.google.com → APIs → Maps Embed API
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...
